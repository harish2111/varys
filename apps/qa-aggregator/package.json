{
  "name": "@varys/qa-aggregator",
  "version": "1.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "start": "node dist/main.js",
    "test": "echo \"(no unit tests)\"",
    "lint": "eslint src --max-warnings 0",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@varys/config": "workspace:*",
    "@varys/contracts": "workspace:*",
    "@varys/db": "workspace:*",
    "@varys/queue": "workspace:*",
    "@varys/telemetry": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "drizzle-orm": "^0.36.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "5.6.3",
    "ts-node-dev": "^2.0.0"
  }
}
