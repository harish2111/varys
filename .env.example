# ============================================================================
# Varys — AI-Powered Connector QA Platform
# Copy to .env for local development (docker-compose wires sane defaults).
# ============================================================================

# ---- Runtime ----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# ---- PostgreSQL (via PgBouncer in transaction mode) -------------------------
# App connects as a NON-superuser role so Row-Level Security is enforced.
DATABASE_URL=postgresql://varys_app:varys_app_pw@localhost:6432/varys
# Direct (non-pooled) URL used ONLY by the migration runner (needs session features).
DATABASE_DIRECT_URL=postgresql://varys_owner:varys_owner_pw@localhost:5432/varys
DATABASE_POOL_MAX=10

# ---- Redis (BullMQ queues, cache, governor state) ---------------------------
REDIS_URL=redis://localhost:6379
# Logical DB used for the LRU result/vector cache (queues use DB 0, no-eviction).
REDIS_CACHE_DB=1

# ---- Auth -------------------------------------------------------------------
JWT_SECRET=change-me-in-prod-a-long-random-string
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=2592000
# Shared secret for internal service-to-service HMAC headers.
INTERNAL_SERVICE_SECRET=change-me-internal-shared-secret

# ---- Admission / concurrency (spec §4) --------------------------------------
APP_QUEUE_CONCURRENCY=10
UNIT_WORKER_CONCURRENCY=8
SANDBOX_WORKER_CONCURRENCY=4

# ---- Gemini API (spec §15) --------------------------------------------------
# Provided at runtime by the operator.
GEMINI_API_KEY=
GEMINI_MODEL_FLASH=gemini-2.5-flash
GEMINI_MODEL_PRO=gemini-2.5-pro
GEMINI_MODEL_EMBED=gemini-embedding-001
GEMINI_EMBED_DIM=768
# Flash → Pro escalation: escalate when Flash confidence < threshold.
GEMINI_ESCALATION_CONFIDENCE=0.85

# ---- Gemini Rate Governor (Redis token buckets) -----------------------------
# Seed from the project's REAL quota tier before launch (spec §4.4 figures are illustrative).
GOVERNOR_FLASH_RPM=1000
GOVERNOR_FLASH_TPM=2000000
GOVERNOR_PRO_RPM=150
GOVERNOR_PRO_TPM=200000
GOVERNOR_EMBED_RPM=1500
GOVERNOR_EMBED_TPM=1000000
GOVERNOR_ACQUIRE_TIMEOUT_MS=60000

# ---- Pricing (USD per 1M tokens) for gemini_usage cost metering -------------
PRICE_FLASH_INPUT_PER_M=0.075
PRICE_FLASH_CACHED_PER_M=0.01875
PRICE_FLASH_OUTPUT_PER_M=0.30
PRICE_PRO_INPUT_PER_M=1.25
PRICE_PRO_CACHED_PER_M=0.3125
PRICE_PRO_OUTPUT_PER_M=10.00
PRICE_EMBED_INPUT_PER_M=0.15

# ---- Retrieval (spec §9) ----------------------------------------------------
RETRIEVAL_VECTOR_TOPK=25
RETRIEVAL_FTS_TOPK=25
RETRIEVAL_FINAL_TOPK=3
RETRIEVAL_RRF_K=60
RETRIEVAL_RERANK_ENABLED=true
RETRIEVAL_RERANK_MARGIN=0.15

# ---- Object storage (GCS in prod, MinIO locally) ----------------------------
GCS_ENDPOINT=http://localhost:9000
GCS_BUCKET=varys-artifacts
GCS_ACCESS_KEY=minioadmin
GCS_SECRET_KEY=minioadmin

# ---- Sandbox (spec §13, §16) ------------------------------------------------
SANDBOX_MEMORY_MB=128
SANDBOX_CPU_TIMEOUT_MS=2000
SANDBOX_WALL_TIMEOUT_MS=10000
# Egress allowlist proxy for live tests (Squid).
EGRESS_PROXY_URL=http://localhost:3128

# ---- Doc ingestion (spec §8) ------------------------------------------------
CRAWL_RATE_PER_SEC=5
CRAWL_MAX_DEPTH=3
CRAWL_PROXY_URL=

# ---- Observability (spec §17) -----------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAMESPACE=varys
COST_DAILY_ALERT_SPIKE_PCT=15

# ---- Service ports ----------------------------------------------------------
GATEWAY_PORT=3000
LLM_GATEWAY_PORT=3001

# ---- Internal service URLs (override port defaults for multi-host deployments) --
# In Kubernetes, set these to the cluster-internal DNS names:
#   LLM_GATEWAY_URL=http://llm-gateway:3001
LLM_GATEWAY_URL=
